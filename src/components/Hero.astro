---
import SiteButton from './SiteButton.astro';

const cards = [
  {
    image: '/assets/icons/material-symbols-light_inventory-rounded.png',
    alt: 'Inventory Icon',
    title: 'Largest inventory in South Florida',
  },
  {
    image: '/assets/icons/dimond-alt-light.png',
    alt: 'Dimond Alt Light Icon',
    title: 'Premium brands  in stock',
  },
  {
    image: '/assets/icons/eye-check.png',
    alt: 'Eye Check Icon',
    title: 'Expert product guidance',
  },
  {
    image: '/assets/icons/estimate-calculator.png',
    alt: 'Estimate Calculator Icon',
    title: 'Free estimates',
  },
  {
    image: '/assets/icons/lucide-house.png',
    alt: 'Lucide House Icon',
    title: 'Residential & Commercial projects',
  },
];
---

<section
  class="relative z-2 overflow-hidden rounded-b-2xl bg-[url(/assets/banner-composite-decking-miami.webp)] bg-cover bg-center pt-22 pb-10 sm:rounded-b-4xl sm:pt-32 sm:pb-20 md:pt-64 md:pb-25"
>
  <div class="mx-auto max-w-350 px-5">
    <!-- Top Header Layout: Title & Buttons (Left) + Text (Right) -->
    <div
      class="relative mb-8 flex flex-col-reverse items-center md:mb-32 md:flex-row md:items-start"
    >
      <!-- Left Column: Title with 2 Buttons Below -->
      <div class="w-full text-left md:w-[60%]">
        <!-- Headline -->
        <h1
          class="mt-10 mb-6 text-center text-3xl font-medium text-white uppercase md:text-left md:text-5xl md:!leading-[40px] lg:mt-0 lg:text-6xl lg:!leading-[70px]"
        >
          Miami's<br /> Largest Selection of Composite Decking
        </h1>

        <p
          class="text-md mb-5 block text-center leading-relaxed font-light text-white md:hidden"
        >
          Premium composite decking, docks, cladding, wall panels, and outdoor
          solutions from the industry's leading brands.
        </p>

        <div
          class="mx-auto flex w-[80%] flex-col items-stretch justify-center gap-4 pt-2 sm:items-center md:mx-0 md:w-auto md:flex-row md:justify-start"
        >
          <SiteButton text="Get a Free Estimate" link="#contact" />
          <SiteButton text="Call Now" link="tel:+17547785759" />
        </div>
      </div>

      <!-- Right Column: Text Arriba a la Derecha -->
      <div
        class="static top-[-80px] right-0 hidden w-full flex-row-reverse items-start gap-2 sm:w-95 sm:gap-4 md:absolute md:flex md:flex-row"
      >
        <p
          class="text-md m-0 text-left leading-relaxed font-light text-white md:text-lg lg:text-right"
        >
          Premium composite decking, docks, cladding, wall panels, and outdoor
          solutions from the industry's leading brands.
        </p>

        <div
          class="flex min-h-7 min-w-7 items-center justify-center rounded-full bg-white/30"
        >
          <span class="min-h-3 min-w-3 rounded-full bg-white"></span>
        </div>
      </div>
    </div>

    <!-- Slider Container -->
    <div class="relative w-full">
      <!-- Cards Wrapper -->
      <div
        id="hero-cards-slider"
        class="flex snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto pt-4 pb-4 [-ms-overflow-style:none] md:flex-wrap md:justify-center md:overflow-visible md:pb-0 [&::-webkit-scrollbar]:hidden"
      >
        {
          cards.map((card) => (
            <div class="group relative flex w-[calc(50%-8px)] flex-shrink-0 snap-start flex-col items-center justify-center gap-2 overflow-hidden rounded-2xl border border-white bg-white/20 p-4 text-center text-xs backdrop-blur-[1px] transition-all duration-300 hover:-translate-y-1 sm:w-[46%] sm:flex-row sm:p-6 sm:text-left sm:text-sm md:w-[28%] md:flex-auto md:snap-none xl:w-[18%]">
              <img src={card.image} alt={card.alt} class="h-8 sm:h-8" />
              <h3 class="font-normal text-white">{card.title}</h3>
            </div>
          ))
        }
      </div>

      <!-- Progress Bar (Mobile only) -->
      <div
        class="relative mx-auto mt-2 h-0.5 w-[60%] overflow-hidden rounded-full bg-white/30 md:hidden"
      >
        <div
          id="hero-cards-progress"
          class="absolute top-0 left-0 h-full w-[40%] rounded-full bg-white transition-all duration-150 ease-out"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroSlider() {
    const slider = document.getElementById('hero-cards-slider');
    const progress = document.getElementById('hero-cards-progress');

    if (slider && progress) {
      const updateProgress = () => {
        const scrollLeft = slider.scrollLeft;
        const maxScroll = slider.scrollWidth - slider.clientWidth;

        if (maxScroll > 0) {
          const scrollPercentage = scrollLeft / maxScroll;
          // Progress bar is 40% width, so it can move up to 60% (100 - 40)
          const maxLeft = 60;
          progress.style.left = `${scrollPercentage * maxLeft}%`;
        }
      };

      slider.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }
  }

  document.addEventListener('astro:page-load', initHeroSlider);
  document.addEventListener('DOMContentLoaded', initHeroSlider);
</script>
