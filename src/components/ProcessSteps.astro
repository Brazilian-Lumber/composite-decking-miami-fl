---
import ProcessStepsSlider from './ProcessStepsSlider.astro';

const steps = [
  {
    image: '/assets/icons/user-comment.png',
    label: 'Tell us about your project',
  },
  {
    image: '/assets/icons/select-multiple.png',
    label: 'Receive product recommendations',
  },
  {
    image: '/assets/icons/paint-bucket.png',
    label: 'Select colors and materials',
  },
  {
    image: '/assets/icons/chat-round-money-broken.png',
    label: 'Get pricing and estimate',
  },
  {
    image: '/assets/icons/wood.png',
    label: 'Build your dream outdoor space',
  },
];
---

<section id="project-types" class="process-section px-5 pt-8 pb-12 md:py-16">
  <div class="mx-auto flex w-full max-w-350 flex-col gap-10">
    <div
      class="flex items-start gap-2 sm:items-center sm:justify-center sm:gap-6"
    >
      <div
        class="flex min-h-5 min-w-5 items-center justify-center rounded-full bg-[#D65311]/20 sm:min-h-7 sm:min-w-7"
      >
        <span
          class="min-h-2 min-w-2 rounded-full bg-[#D65311] sm:min-h-3 sm:min-w-3"
        ></span>
      </div>
      <h2
        class="w-[75%] text-xl leading-tight text-[#D65311] uppercase sm:w-auto lg:text-4xl"
      >
        Designed for Every Outdoor Space
      </h2>
    </div>

    <!-- Mobile Layout (Slider) -->
    <ProcessStepsSlider steps={steps} />

    <!-- Desktop Layout (Hidden on Mobile) -->
    <div class="hidden w-full flex-wrap justify-center lg:flex">
      {
        steps.map((step) => (
          <div class="circle-item mx-[-10px] flex max-h-[250px] min-h-[250px] max-w-[250px] min-w-[250px] flex-col items-center justify-center gap-4 rounded-full border border-dashed border-[#FF5623] p-6 transition-all duration-300 hover:scale-105">
            <div class="circle-card">
              <img
                src={step.image}
                alt={step.label}
                class="circle-img h-14 object-contain xl:h-16"
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="circle-label w-[75%] text-center text-sm xl:text-base">
              {step.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process-dot-ring {
    background: #ffdcb94d;
    min-width: 28px;
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .process-dot-inner {
    background: #d65311;
    min-width: 12px;
    min-height: 12px;
    border-radius: 50%;
  }
</style>
