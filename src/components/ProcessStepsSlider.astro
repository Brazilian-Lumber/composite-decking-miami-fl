---
import '@splidejs/splide/css';

const { steps } = Astro.props;
---

<!-- Mobile Layout (Splide Slider, Hidden on Desktop) -->
<div class="splide block w-full lg:hidden" id="process-splide">
  <div class="splide__track w-full">
    <ul class="splide__list">
      {
        steps.map((step: any) => (
          <li class="splide__slide flex justify-center">
            <div class="circle-item flex max-h-[180px] min-h-[180px] max-w-[180px] min-w-[180px] flex-col items-center justify-center gap-3 rounded-full border border-dashed border-[#FF5623] p-5 transition-all duration-300 hover:scale-105 sm:max-h-[200px] sm:min-h-[200px] sm:max-w-[200px] sm:min-w-[200px]">
              <div class="circle-card">
                <img
                  src={step.image}
                  alt={step.label}
                  class="circle-img h-12 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="circle-label w-[70%] text-center text-xs leading-tight sm:w-[90%]">
                {step.label}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import Splide from '@splidejs/splide';

  document.addEventListener('DOMContentLoaded', () => {
    const splideElement = document.getElementById('process-splide');
    if (splideElement) {
      new Splide(splideElement, {
        type: 'slide',
        perPage: 3.5,
        perMove: 1,
        arrows: false,
        pagination: true,
        gap: '1rem',
        focus: 'center', // Centers the active slide
        breakpoints: {
          600: {
            perPage: 2.5,
          },
          425: {
            perPage: 1.8,
          },
        },
      }).mount();
    }
  });
</script>

<style>
  :global(.splide__pagination) {
    bottom: -1.5rem;
    gap: 0.5rem;
  }
  :global(.splide__pagination__page) {
    background: #9ca3af;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    transition: all 0.3s ease;
    opacity: 1;
    margin: 0;
  }
  :global(.splide__pagination__page.is-active) {
    background: #2d0863;
    width: 2rem;
    transform: scale(1);
  }
</style>
