---
const items = [
  {
    title: 'Premium Products',
  },
  {
    title: 'Superior Service',
  },
  {
    title: 'Large Local Inventory',
  },
  {
    title: 'Exceptional Prices',
  },
  {
    title: 'Expert Guidance',
  },
  {
    title: 'Florida Climate Expertise',
  },
];
---

<section id="services-grid" class="bg-[#2D0863] px-5 py-16 lg:py-28">
  <div class="services-grid-container">
    <!-- Left: Title & Description -->
    <div class="services-grid-left">
      <!-- 
      <h2 class="text-2xl text-[#FE7F03] uppercase lg:text-4xl">
        More Than a Supplier
      </h2>
      -->

      <div class="flex items-start gap-2 sm:items-center sm:gap-6">
        <div
          class="flex min-h-5 min-w-5 items-center justify-center rounded-full bg-[#fff]/20 sm:min-h-7 sm:min-w-7"
        >
          <span
            class="min-h-2 min-w-2 rounded-full bg-[#fff] sm:min-h-3 sm:min-w-3"
          ></span>
        </div>
        <h2
          class="text-xl leading-tight text-[#FE7F03] uppercase sm:w-auto lg:text-4xl"
        >
          More Than a Supplier
        </h2>
      </div>
      <p class="text-md ml-7 font-light text-white sm:ml-14 md:text-lg">
        At Composite Decking Miami FL, our goal is to provide customers with the
        best shopping experience through premium products, exceptional pricing,
        and superior service.
      </p>
    </div>

    <!-- Right: 6 Items Grid -->
    <div class="services-grid-right mx-auto max-w-87.5 sm:max-w-full">
      {
        items.map((item) => (
          <div class="flex items-center gap-4 transition-all duration-300 ease-in-out hover:-translate-y-2">
            <img
              src="/assets/icons/check-icon.png"
              alt="Check Icon"
              class="h-6 sm:h-10"
              loading="lazy"
            />
            <h3 class="text-white">{item.title}</h3>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 450px 600px;
    gap: 60px;
    align-items: center;
    justify-content: space-between;
  }
  /* ── Left ── */
  .services-grid-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* ── Right Grid ── */
  .services-grid-right {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 70px;
    row-gap: 40px;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .services-grid-container {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .services-grid-left {
      position: static;
      align-items: start;
      text-align: start;
    }
  }

  @media (max-width: 640px) {
    .services-grid-right {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 40px;
    }
  }
</style>
