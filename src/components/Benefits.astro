---
const services = [
  {
    title: 'Low maintenance',
  },
  {
    title: 'Fade resistant',
  },
  {
    title: 'Stain resistant',
  },
  {
    title: 'Scratch resistant',
  },
  {
    title: 'Mold resistant',
  },
  {
    title: 'Sustainable materials',
  },
  {
    title: 'No sanding, staining, or painting required',
  },
];
---

<section
  id="about-us"
  class="relative z-1 mt-[-30px] bg-[#2D0863] pt-20 pb-14 lg:py-24"
>
  <div class="mx-auto max-w-350 px-5">
    <div class="grid grid-cols-1 gap-8 sm:gap-12 lg:grid-cols-12 lg:gap-20">
      <!-- Left Column: Title & Subtitle (Sticky on Desktop) -->
      <div
        class="space-y-6 self-start text-white lg:sticky lg:top-28 lg:col-span-5"
      >
        <div class="flex items-start gap-2 sm:gap-5">
          <div
            class="flex min-h-5 min-w-5 items-center justify-center rounded-full bg-white/30 sm:min-h-7 sm:min-w-7 lg:-ml-11.25"
          >
            <span
              class="min-h-2 min-w-2 rounded-full bg-white sm:min-h-3 sm:min-w-3"
            ></span>
          </div>

          <h2 class="text-xl leading-tight uppercase lg:text-4xl">
            The Smarter<br /> Alternative to Wood
          </h2>
        </div>

        <p class="ml-8 text-base leading-relaxed font-light sm:ml-0 sm:text-lg">
          Composite decking delivers the beauty of natural wood without the
          ongoing maintenance. Designed to withstand Florida's demanding
          climate, composite materials offer exceptional durability, resistance
          to fading, staining, moisture, and mold while maintaining their
          appearance for years.
        </p>
      </div>

      <!-- Right Column: Services List (Numbered & Separated by Line) -->
      <div
        class="m-auto max-w-90 divide-y divide-white sm:m-0 sm:max-w-full lg:col-span-7"
      >
        {
          services.map((service, index) => {
            const num = String(index + 1).padStart(2, '0');
            return (
              <div class="group flex items-center justify-between px-5 py-6 text-white transition-all duration-300 first:pt-0 sm:gap-6 sm:px-8 sm:py-8">
                <div class="flex items-center gap-5 sm:gap-16">
                  <span class="text-wood-light text-lg font-medium tracking-wider opacity-100 transition-opacity duration-300 group-hover:opacity-100 sm:text-xl sm:opacity-60">
                    {num}
                  </span>
                  <h3 class="text-md group-hover:text-wood-light font-light transition-all duration-300 group-hover:translate-x-3 sm:text-xl">
                    {service.title}
                  </h3>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
